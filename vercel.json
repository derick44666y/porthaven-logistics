{
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.ico|favicon\\.png|favicon-|apple-touch-icon|android-chrome|site\\.webmanifest|robots\\.txt|sitemap\\.xml|og-image\\.jpg|logo\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Type", "value": "image/x-icon" }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/favicon-(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
